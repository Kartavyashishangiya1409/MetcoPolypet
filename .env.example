# Public site origin, used for canonical URLs, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.metcopolypet.com

# Resend (https://resend.com) — enquiry form email
RESEND_API_KEY=
# Where enquiries are delivered (comma-separated for several inboxes)
ENQUIRY_TO=sales@metcopolypet.com
# Verified sender on your Resend domain
ENQUIRY_FROM="Metco Polypet <enquiries@metcopolypet.com>"
